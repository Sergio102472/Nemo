$nemo_exchange $mol_view
	title \Nemo
	sub /
		<= Title $mol_text
			text <= title
		<= From_row $mol_view
			sub /
				<= From_currency $mol_button_major
					title <= from_currency \BTC
					click?event <=> choose_from?event null
				<= From_amount $mol_number
					value?val <=> from_amount?val 0
					hint \Сумма
		<= To_row $mol_view
			sub /
				<= To_currency $mol_button_major
					title <= to_currency \USDT
					click?event <=> choose_to?event null
				<= To_amount $mol_number
					value?val <=> to_amount?val 0
					hint \Сумма
		<= Fee $mol_text
			text \Комиссия 2%
