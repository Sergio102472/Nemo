$nemo_module1 $mol_page
	title \Nemo — Модуль 1
	body /
		<= Log $mol_list
			rows <= log_rows /
		<= Form $mol_form
			fields /
				<= Selects $mol_row
					sub /
						<= From $mol_select
							value? <=> from_currency?
							options <= currency_options
							hint \Отдаёте
						<= To $mol_select
							value? <=> to_currency?
							options <= currency_options
							hint \Получаете
				<= Amounts $mol_row
					sub /
						<= From_amount $mol_number
							value? <=> from_amount?
							hint \Сумма
						<= To_amount $mol_number
							value <= to_amount
							hint \Сумма
							enabled \false
				<= Rate $mol_text
					text <= rate_text
				<= Swap $mol_button_major
					title \Обменять
					click? <=> event_swap?
					enabled <= can_swap
